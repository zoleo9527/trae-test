{
  "name": "natatorium-ops",
  "version": "1.0.0",
  "description": "游泳馆运营桌面工具 - 储物柜分配与异常申诉",
  "main": "dist-electron/main.js",
  "author": "Natatorium Ops Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && electron-builder",
    "preview": "vite preview",
    "start": "electron ."
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dayjs": "^1.11.13",
    "pinia": "^2.2.2",
    "vue": "^3.5.0",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.4",
    "@vitejs/plugin-vue": "^5.1.3",
    "electron": "^32.1.0",
    "electron-builder": "^25.0.5",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vue-tsc": "^2.1.4"
  },
  "build": {
    "appId": "com.natatorium.ops",
    "productName": "游泳馆运营控制台",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
