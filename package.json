{
  "name": "recycle-station",
  "version": "1.0.0",
  "description": "废品回收站-分拣入库与价格调整管理系统",
  "main": "backend/src/index.js",
  "scripts": {
    "dev": "node backend/src/index.js",
    "start": "node backend/src/index.js",
