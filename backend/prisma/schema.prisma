generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String
  email     String?
  phone     String?
  role      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdSchedules   Schedule[]        @relation("ScheduleCreator")
  updatedSchedules   Schedule[]        @relation("ScheduleUpdater")
  borrowRequests     EquipmentBorrow[] @relation("BorrowRequester")
  borrowApprovals    EquipmentBorrow[] @relation("BorrowApprover")
  createdReviews     PerformanceReview[] @relation("ReviewCreator")
  createdGroupOrders GroupOrder[]      @relation("OrderCreator")
  auditLogs          AuditLog[]
  createdRemarks     Remark[]
  loginTokens        LoginToken[]
  scheduleStatusChanges ScheduleStatusHistory[] @relation("ScheduleStatusChanger")
  borrowStatusChanges   BorrowStatusHistory[]   @relation("BorrowStatusChanger")
  orderStatusChanges    OrderStatusHistory[]    @relation("OrderStatusChanger")
}

model LoginToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  role      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])
}

model Schedule {
  id            String   @id @default(uuid())
  performanceName String
  performanceType String?
  startTime     DateTime
  endTime       DateTime
  venue         String
  status        String   @default("DRAFT")
  castList      String?
  description   String?
  createdById   String
  updatedById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy      User                @relation("ScheduleCreator", fields: [createdById], references: [id])
  updatedBy      User                @relation("ScheduleUpdater", fields: [updatedById], references: [id])
  equipmentBorrows EquipmentBorrow[]
  reviews        PerformanceReview[]
  groupOrders    GroupOrder[]
  remarks        Remark[]           @relation("ScheduleRemarks")
  statusHistory  ScheduleStatusHistory[]
}

model ScheduleStatusHistory {
  id           String         @id @default(uuid())
  scheduleId   String
  oldStatus    String?
  newStatus    String
  changedById  String
  changeReason String?
  createdAt    DateTime       @default(now())

  schedule Schedule @relation(fields: [scheduleId], references: [id])
  changedBy User     @relation("ScheduleStatusChanger", fields: [changedById], references: [id])
}

model Equipment {
  id           String   @id @default(uuid())
  name         String
  category     String
  specification String?
  quantity     Int      @default(1)
  availableQty Int      @default(1)
  location     String?
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  borrowRecords EquipmentBorrow[]
  remarks       Remark[]          @relation("EquipmentRemarks")
}

model EquipmentBorrow {
  id             String                @id @default(uuid())
  scheduleId     String
  equipmentId    String
  borrowQty      Int
  requestReason  String
  expectedReturnDate DateTime
  actualReturnDate   DateTime?
  status         String                @default("PENDING")
  rejectReason   String?
  supplementNote String?
  requestedById  String
  approvedById   String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  schedule     Schedule  @relation(fields: [scheduleId], references: [id])
  equipment    Equipment @relation(fields: [equipmentId], references: [id])
  requestedBy  User      @relation("BorrowRequester", fields: [requestedById], references: [id])
  approvedBy   User?     @relation("BorrowApprover", fields: [approvedById], references: [id])
  remarks      Remark[]  @relation("BorrowRemarks")
  statusHistory BorrowStatusHistory[]
}

model BorrowStatusHistory {
  id            String                @id @default(uuid())
  borrowId      String
  oldStatus     String?
  newStatus     String
  changedById   String
  changeReason  String?
  createdAt     DateTime              @default(now())

  borrow    EquipmentBorrow @relation(fields: [borrowId], references: [id])
  changedBy User            @relation("BorrowStatusChanger", fields: [changedById], references: [id])
}

model PerformanceReview {
  id              String              @id @default(uuid())
  scheduleId      String
  reviewContent   String
  overallRating   Int?
  issuesFound     String?
  improvementSuggestions String?
  createdById     String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  schedule    Schedule  @relation(fields: [scheduleId], references: [id])
  createdBy   User      @relation("ReviewCreator", fields: [createdById], references: [id])
  reviewIssues ReviewIssue[]
  remarks      Remark[]  @relation("ReviewRemarks")
}

model ReviewIssue {
  id          String             @id @default(uuid())
  reviewId    String
  title       String
  description String
  severity    String
  status      String             @default("OPEN")
  responsibleParty String?
  resolvedAt  DateTime?
  resolution  String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  review  PerformanceReview @relation(fields: [reviewId], references: [id])
  remarks Remark[]          @relation("IssueRemarks")
}

model GroupOrder {
  id              String           @id @default(uuid())
  scheduleId      String
  groupName       String
  contactPerson   String
  contactPhone    String
  ticketCount     Int
  unitPrice       Float
  totalAmount     Float
  actualPaid      Float?
  status          String           @default("PENDING")
  rejectReason    String?
  refundReason    String?
  refundAmount    Float?
  createdById     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  schedule     Schedule @relation(fields: [scheduleId], references: [id])
  createdBy    User     @relation("OrderCreator", fields: [createdById], references: [id])
  remarks      Remark[] @relation("OrderRemarks")
  statusHistory OrderStatusHistory[]
}

model OrderStatusHistory {
  id           String           @id @default(uuid())
  orderId      String
  oldStatus    String?
  newStatus    String
  changedById  String
  changeReason String?
  createdAt    DateTime         @default(now())

  order     GroupOrder @relation(fields: [orderId], references: [id])
  changedBy User       @relation("OrderStatusChanger", fields: [changedById], references: [id])
}

model Remark {
  id            String  @id @default(uuid())
  content       String
  isSupplement  Boolean @default(false)
  createdById   String
  createdAt     DateTime @default(now())

  scheduleId    String?
  equipmentId   String?
  borrowId      String?
  reviewId      String?
  issueId       String?
  orderId       String?

  createdBy     User                @relation(fields: [createdById], references: [id])
  schedule      Schedule?           @relation("ScheduleRemarks", fields: [scheduleId], references: [id])
  equipment     Equipment?          @relation("EquipmentRemarks", fields: [equipmentId], references: [id])
  borrow        EquipmentBorrow?    @relation("BorrowRemarks", fields: [borrowId], references: [id])
  review        PerformanceReview?  @relation("ReviewRemarks", fields: [reviewId], references: [id])
  issue         ReviewIssue?        @relation("IssueRemarks", fields: [issueId], references: [id])
  order         GroupOrder?         @relation("OrderRemarks", fields: [orderId], references: [id])
}

model AuditLog {
  id            String      @id @default(uuid())
  userId        String
  action        String
  entityType    String
  entityId      String
  fieldName     String?
  oldValue      String?
  newValue      String?
  changeSummary String?
  ipAddress     String?
  userAgent     String?
  requestId     String?
  createdAt     DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])
}

model IdempotencyRecord {
  id        String   @id @default(uuid())
  key       String   @unique
  response  String
  createdAt DateTime @default(now())
  expiresAt DateTime
}
