// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== 枚举类型（SQLite 兼容：使用 String + 代码层验证）====================
// 角色类型
// STORE_OWNER: 门店老板，RENTAL_ADVISOR: 租赁顾问，MAINTENANCE_TECH: 维修师傅

// 乐器状态
// AVAILABLE: 可租，RENTED: 已租出，IN_MAINTENANCE: 维修中，DAMAGED: 损坏待处理，RETIRED: 已报废

// 租赁状态
// ACTIVE: 租赁中，RETURNED: 已归还待结算，SETTLED: 已结算完成，OVERDUE: 逾期未还

// 押金状态
// HELD: 押金保管中，REFUNDING: 退款中，REFUNDED: 已全额退还
// PARTIAL_REFUNDED: 部分退还，DEDUCTED: 全额扣除，DISPUTED: 有争议

// 损坏申诉状态
// PENDING: 待处理，CONFIRMED: 已确认无异议，DISPUTED: 客户申诉
// REJECTED: 申诉驳回，RESOLVED: 申诉通过，CLOSED: 已结案

// 损坏严重程度
// MINOR: 轻微，MODERATE: 中度，MAJOR: 严重，TOTAL: 报废级

// 审计动作类型
// RENTAL_xxx: 租赁相关，DEPOSIT_xxx: 押金相关，DAMAGE_xxx: 损坏申诉相关
// MAINTENANCE_xxx: 维修相关，NOTE_xxx: 备注相关

// 实体类型
// RENTAL: 租赁单，DEPOSIT: 押金单，DAMAGE_CLAIM: 损坏申诉，MAINTENANCE: 维修单，INSTRUMENT: 乐器

// ==================== 核心数据模型 ====================

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  password      String
  name          String
  phone         String?
  role          String   // Role enum: STORE_OWNER | RENTAL_ADVISOR | MAINTENANCE_TECH
  storeId       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  // 反向关系
  createdRentals       Rental[]        @relation("rentalCreatedBy")
  handledRentals       Rental[]        @relation("rentalHandledBy")
  createdDeposits      Deposit[]       @relation("depositCreatedBy")
  handledDeposits      Deposit[]       @relation("depositHandledBy")
  createdDamageClaims  DamageClaim[]   @relation("damageCreatedBy")
  handledDamageClaims  DamageClaim[]   @relation("damageHandledBy")
  createdMaintenances  Maintenance[]   @relation("maintCreatedBy")
  handledMaintenances  Maintenance[]   @relation("maintHandledBy")
  createdNotes         Note[]          @relation("noteCreatedBy")
  auditLogs            AuditLog[]      @relation("auditOperator")
}

model Customer {
  id            String   @id @default(uuid())
  name          String
  phone         String   @unique
  idCard        String?  // 身份证号
  address       String?
  email         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  // 反向关系
  rentals   Rental[]
  deposits  Deposit[]
}

model Instrument {
  id             String   @id @default(uuid())
  name           String   // 乐器名称
  category       String   // 分类：吉他、钢琴、小提琴等
  brand          String?  // 品牌
  model          String?  // 型号
  serialNumber   String   @unique
  purchasePrice  Decimal  // 购置价
  rentalPrice    Decimal  // 日租金
  depositAmount  Decimal  // 标准押金
  status         String   // InstrumentStatus enum
  description    String?
  lastCheckDate  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())

  // 反向关系
  rentals         Rental[]
  damageClaims    DamageClaim[]
  maintenances    Maintenance[]
}

model Rental {
  id               String   @id @default(uuid())
  rentalNo         String   @unique // 租赁单号
  customerId       String
  instrumentId     String
  startDate        DateTime
  expectedEndDate  DateTime
  actualEndDate    DateTime?
  dailyRate        Decimal  // 实际日租金（可能有折扣）
  depositAmount    Decimal  // 实际收取押金
  totalRentalFee   Decimal  @default(0) // 累计租金
  status           String   // RentalStatus enum
  isSchoolCooperation Boolean  @default(false) // 是否学校合作
  schoolContractNo String?  // 学校合同编号
  createdBy        String
  handledBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())

  // 关系
  customer         Customer     @relation(fields: [customerId], references: [id])
  instrument       Instrument   @relation(fields: [instrumentId], references: [id])
  creator          User         @relation("rentalCreatedBy", fields: [createdBy], references: [id])
  handler          User?        @relation("rentalHandledBy", fields: [handledBy], references: [id])
  deposit          Deposit?
  damageClaims     DamageClaim[]
}

model Deposit {
  id               String   @id @default(uuid())
  depositNo        String   @unique // 押金单号
  rentalId         String   @unique
  amount           Decimal  // 押金总额
  status           String   @default("HELD") // DepositStatus enum
  refundAmount     Decimal  @default(0) // 实际退还金额
  deductAmount     Decimal  @default(0) // 扣除金额（赔偿）
  paymentMethod    String?  // 退款/扣款方式
  transactionId    String?  // 支付交易号
  createdBy        String
  handledBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())

  // 关系
  customerId       String? // 显式客户关系，便于查询
  customer         Customer?    @relation(fields: [customerId], references: [id])
  rental           Rental       @relation(fields: [rentalId], references: [id])
  creator          User         @relation("depositCreatedBy", fields: [createdBy], references: [id])
  handler          User?        @relation("depositHandledBy", fields: [handledBy], references: [id])
}

model DamageClaim {
  id               String   @id @default(uuid())
  claimNo          String   @unique // 申诉单号
  rentalId         String
  instrumentId     String
  description      String   // 损坏描述
  estimatedCost    Decimal  // 预估维修/赔偿费用
  severity         String   // DamageSeverity enum
  evidenceUrls     String?  // 损坏照片URL，逗号分隔（SQLite 不支持数组）
  status           String   @default("PENDING") // DamageClaimStatus enum
  disputeReason    String?  // 申诉原因（用户填写）
  rejectReason     String?  // 驳回原因
  resolvedReason   String?  // 申诉通过原因
  finalCost        Decimal? // 最终赔偿金额
  createdBy        String
  handledBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())

  // 关系
  rental           Rental       @relation(fields: [rentalId], references: [id])
  instrument       Instrument   @relation(fields: [instrumentId], references: [id])
  creator          User         @relation("damageCreatedBy", fields: [createdBy], references: [id])
  handler          User?        @relation("damageHandledBy", fields: [handledBy], references: [id])
  maintenance      Maintenance?
}

model Maintenance {
  id               String   @id @default(uuid())
  maintenanceNo    String   @unique // 维修单号
  instrumentId     String
  damageClaimId    String?  @unique // 关联损坏申诉（可选，一对一）
  description      String   // 维修内容描述
  partsCost        Decimal  @default(0) // 配件费
  laborCost        Decimal  @default(0) // 人工费
  totalCost        Decimal  @default(0) // 总费用
  status           String   @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  startDate        DateTime
  completeDate     DateTime?
  createdBy        String
  handledBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())

  // 关系
  instrument       Instrument   @relation(fields: [instrumentId], references: [id])
  damageClaim      DamageClaim? @relation(fields: [damageClaimId], references: [id])
  creator          User         @relation("maintCreatedBy", fields: [createdBy], references: [id])
  handler          User?        @relation("maintHandledBy", fields: [handledBy], references: [id])
}

model Note {
  id               String   @id @default(uuid())
  entityType       String   // EntityType enum: RENTAL | DEPOSIT | DAMAGE_CLAIM | MAINTENANCE
  entityId         String
  content          String   // 备注内容
  isSupplement     Boolean  @default(false) // 是否补录
  supplementReason String?  // 补录原因
  createdBy        String
  createdAt        DateTime @default(now())

  // 关系
  creator          User        @relation("noteCreatedBy", fields: [createdBy], references: [id])

  // 索引
  @@index([entityType, entityId])
  @@index([createdBy])
}

model AuditLog {
  id               String   @id @default(uuid())
  action           String   // AuditAction enum
  entityType       String   // EntityType enum
  entityId         String
  oldValue         String?  // 变更前值（JSON 字符串，SQLite 不支持 Json 类型）
  newValue         String?  // 变更后值（JSON 字符串）
  changes          String?  // 具体变更字段（JSON 字符串）
  remark           String?  // 操作说明
  operatorId       String
  operatorName     String?
  operatorRole     String?
  idempotencyKey   String?
  responseBody     String?  // 响应体（JSON 字符串，用于幂等返回）
  createdAt        DateTime @default(now())

  // 关系
  operator         User        @relation("auditOperator", fields: [operatorId], references: [id])

  // 索引
  @@index([entityType, entityId])
  @@index([operatorId])
  @@index([action])
  @@index([createdAt])
  @@index([idempotencyKey])
}

model IdempotencyKey {
  id             String   @id @default(uuid())
  key            String   @unique
  requestHash    String
  responseBody   String?  // JSON 字符串
  createdAt      DateTime @default(now())

  @@index([key])
}
